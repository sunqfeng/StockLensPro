# Copy to secrets.env locally; never commit real values.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional Typesafe/Jev integration
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional deployment paths; set to your own local directories.
STOCKLENS_WORKSPACE_DIR=
STOCKLENS_SHADOW_DIR=
