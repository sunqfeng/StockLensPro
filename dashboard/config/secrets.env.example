# Copy to secrets.env locally; never commit real values.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# Optional Typesafe/Jev integration
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional deployment paths; set to your own local directories.
STOCKLENS_WORKSPACE_DIR=
STOCKLENS_SHADOW_DIR=
STOCKLENS_APP_DIR=
STOCKLENS_STRATEGY_DIR=
STOCKLENS_TECH_SCORE_DIR=
STOCKLENS_PYWORKSPACE_DIR=
STOCKLENS_PYWORKSPACE_PYTHON=
STOCKLENS_STRATEGY_PYTHON=
STOCKLENS_TECH_SCORE_PYTHON=
STOCKLENS_TASK_ALLOWED_ROOT=
